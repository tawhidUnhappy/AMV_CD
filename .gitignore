# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.ruff_cache/
.pytest_cache/

# Virtual environments
.venv

# Auto-provisioned cuDNN 8 split libraries (Linux, ~1.1GB) -- see
# amv/audio/torch_compat.py._ensure_cudnn8_libs(). Fetched on first use.
.cudnn8/

# Local configuration: holds machine-specific media paths. config.example.json
# is committed as the template.
config.json

# Generated data. Everything under tmp/ is reproducible by re-running the
# pipeline, and the rendered video alone is ~180MB.
tmp/

# Copyrighted / licensed inputs, supplied locally and never committed:
# the song, the separated vocal stem, and the fonts.
assets/*.mp3
assets/*.wav
assets/*.ttf
assets/*.otf

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
